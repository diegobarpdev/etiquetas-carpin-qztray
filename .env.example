# --- Etiquetas Colineal: Front :3000 + API :3010 ---
WEB_PORT=3000
API_PORT=3010
HOST=0.0.0.0
PUBLIC_URL=http://192.168.2.28:3000
# API_URL=http://127.0.0.1:3010

# Órdenes desde PostgreSQL Odoo (solo lectura)
ODOO_DATABASE_URL="postgresql://USUARIO:CLAVE@172.16.20.116:5432/ctin_produccion?schema=public"
ODOO_READ_ONLY=true

# BD local (inspectores personalizados, cuentas de usuario, etc.)
DATABASE_URL="postgresql://colineal:colineal@localhost:5433/etiquetas?schema=public"

# Config impresoras (JSON en data/)
# PRINTERS_CONFIG_DIR=./data

# Ruta al chrome.exe de Puppeteer. Necesario si el servicio corre como SYSTEM
# (el cache de puppeteer queda en el perfil de usuario, SYSTEM no lo ve).
# PUPPETEER_EXECUTABLE_PATH="C:\Users\TU_USUARIO\.cache\puppeteer\chrome\win64-XXX\chrome-win64\chrome.exe"

# Oscuridad ZPL ^MD (-30..30). Vacío = no forzar (usa el panel de la impresora).
# PRINT_DARKNESS=
# PRINT_DARKNESS_PAPEL aplica a conforme-papel / impresoras con "PAPEL" en el nombre.
PRINT_DARKNESS_PAPEL=25

# Velocidad ZPL ^PR (ips). ZT230 ~6, ZM400 hasta 10 (la impresora recorta si excede su máximo).
PRINT_SPEED_IPS=6

# Crea (si no existe) el primer admin al arrancar — sin esto nadie podría
# aprobar cuentas nuevas nunca (el auto-registro solo deja "pending"). Se
# usa una sola vez para entrar y aprobar/promover a los demás desde la
# app; dejarlo puesto no hace nada si esa cuenta ya existe.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Obligatorio — clave interna entre el proxy del front (web) y la API.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=
